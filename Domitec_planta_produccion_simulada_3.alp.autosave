		<ActiveObjectClass>
			<Id>1787747794958</Id>
			<Name><![CDATA[DomitecPlant]]></Name>
			<StartupCode><![CDATA[// Inventarios iniciales alineados con la cobertura del Lead Time de cada producto
// para evitar el pico artificial de 246.000 cajas en la Semana 0:
inventorySystem.add(new ProductState(ProductType.LAVANDINA, 146000, 26672));
inventorySystem.add(new ProductState(ProductType.LIQUIDO_DESINFECTANTE, 73000, 16217));
inventorySystem.add(new ProductState(ProductType.LAVAVAJILLA, 58000, 9474));
inventorySystem.add(new ProductState(ProductType.LIQUIDO_LAVAR_ROPA, 28000, 7036));
inventorySystem.add(new ProductState(ProductType.SUAVIZANTE, 31000, 4150));
inventorySystem.add(new ProductState(ProductType.DETERGENTE_CONCENTRADO, 10000, 2564));
for (ProductState ps : inventorySystem) {
    productionLines.add(new ProductionLineState(ps.product));
}
cajas_lavandina_0.setVisible(false);
