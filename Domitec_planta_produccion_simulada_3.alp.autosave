		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1787747219700">
			<Id>1793736490733</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>customGenerator</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random(getCurrentReplication())</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[double fr = (root.domitecPlant.demandaTotalAcumulada > 0) ? 
    (root.domitecPlant.despachoTotalAcumulado / root.domitecPlant.demandaTotalAcumulada) * 100.0 : 0.0;

double totBacklog = 0;
double totStock = 0;
for (ProductState ps : root.domitecPlant.inventorySystem) {
    totBacklog += ps.backlog;
    totStock += ps.inventory;
}

// Calculo de Razon BW (Bullwhip Ratio = (Var_Ordenes / Mean_Ordenes) / (Var_Demanda / Mean_Demanda))
double bwRatio = 1.0;
int nDem = root.dsDemanda.size();
int nOrd = root.dsOrdenes.size();
if (nDem > 1 && nOrd > 1) {
    double meanDem = root.dsDemanda.getYMean();
    double meanOrd = root.dsOrdenes.getYMean();
    double sumSqDem = 0;
    double sumSqOrd = 0;
    for (int i = 0; i < nDem; i++) {
        double diffD = root.dsDemanda.getY(i) - meanDem;
        sumSqDem += diffD * diffD;
    }
    for (int i = 0; i < nOrd; i++) {
        double diffO = root.dsOrdenes.getY(i) - meanOrd;
        sumSqOrd += diffO * diffO;
    }
    double varDem = sumSqDem / (nDem - 1);
    double varOrd = sumSqOrd / (nOrd - 1);
    if (meanDem > 0 && varDem > 0 && meanOrd > 0) {
        bwRatio = (varOrd / meanOrd) / (varDem / meanDem);
    }
}

traceln(String.format(">>> [REPLICA #%d] Fill Rate: %.2f%% | Backlog: %,d cajas | Razon BW: %.2f | Stock Deposito: %,d cajas",
    getCurrentReplication(), fr, Math.round(totBacklog), bwRatio, Math.round(totStock)));]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
			<VmArgs><![CDATA[]]></VmArgs>
