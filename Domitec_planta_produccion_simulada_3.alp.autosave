					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// 1. Suma al contador de producción semanal de Main (para los gráficos)
((Main)get_Main()).produccionSemanalActual += agent.cajasEquivalentes;

// 2. Identifica cuál de los 5 líquidos terminó e impacta su inventario correspondiente
for (ProductState ps : inventorySystem) {
    if (ps.product == agent.tipo) {
        ps.inventory += agent.cajasEquivalentes;
        
        // Satisface atrasos acumulados de ese producto si existen
        double recovered = Math.min(ps.inventory, ps.backlog);
        ps.inventory -= recovered;
        ps.backlog -= recovered;
despachoTotalAcumulado += recovered;
        
        /* traceln("LIQUIDO TERMINADO: " + ps.product 
                + " | Stock: " + Math.round(ps.inventory) 
                + " | Backlog restante: " + Math.round(ps.backlog)); */
        break;
    }
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destroyEntity]]></Name>
						</Parameter>
