            <EnvironmentRotationY>0</EnvironmentRotationY>
            <EnvironmentRotationZ>0</EnvironmentRotationZ>
            <EnvironmentIntensity>1</EnvironmentIntensity>
			<AgentProperties>
				<EnvironmentDefinesInitialLocation>true</EnvironmentDefinesInitialLocation>
				<RotateAnimationTowardsMovement>true</RotateAnimationTowardsMovement>
				<RotateAnimationVertically>false</RotateAnimationVertically>
				<VelocityCode Class="CodeUnitValue">
					<Code><![CDATA[10]]></Code>
					<Unit Class="SpeedUnits"><![CDATA[MPS]]></Unit>
				</VelocityCode>
				<MessageType><![CDATA[Object]]></MessageType>
				<OnReceive><![CDATA[if (msg instanceof OrderMessage) {
    OrderMessage order = (OrderMessage) msg;
    double leadTimeSemanas = 0.0;
    
    // Calculamos el insumo más lento (cuello de botella) para cada producto (Días / 7)
    if (order.product == ProductType.LAVANDINA) {
        leadTimeSemanas = 30.0 / 7.0; // Límite: Polietileno (30 días)
    } else if (order.product == ProductType.LIQUIDO_DESINFECTANTE) {
        leadTimeSemanas = 21.0 / 7.0; // Límite: Esencia (21 días)
    } else if (order.product == ProductType.LAVAVAJILLA) {
        leadTimeSemanas = 21.0 / 7.0; // Límite: Tensoactivo/Esencia (21 días)
    } else if (order.product == ProductType.LIQUIDO_LAVAR_ROPA) {
        leadTimeSemanas = 21.0 / 7.0; // Límite: Tensoactivo/Esencia (21 días)
    } else if (order.product == ProductType.SUAVIZANTE) {
        leadTimeSemanas = 45.0 / 7.0; // Límite: Film (45 días)
    } else if (order.product == ProductType.DETERGENTE_CONCENTRADO) {
        leadTimeSemanas = 21.0 / 7.0; // Límite: Tensoactivo/Esencia (21 días)
    }
    
    // Imprimimos el aviso en consola
    // traceln("      [!] PROVEEDOR: Orden de " + order.product + " procesada. Por demora de insumos, se entregará en " + String.format("%.1f", leadTimeSemanas) + " semanas.");
    
    // Programamos el envío del camión con el tiempo exacto que calculamos
    create_DeliverOrder(leadTimeSemanas, WEEK, order.product, order.amount);
}]]></OnReceive>
