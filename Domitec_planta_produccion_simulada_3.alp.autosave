				<OnReceive><![CDATA[// === 1. PEDIDO DEL CLIENTE: DESPACHAR DEL DEPÓSITO ===
if (msg instanceof OrderMessage) {
    OrderMessage order = (OrderMessage) msg;
    
    // Contabilizamos la demanda total solicitada
    demandaTotalAcumulada += order.amount;
    
    for (ProductState ps : inventorySystem) {
        if (ps.product != order.product) continue;
        
        double dispatched = Math.min(ps.inventory, order.amount);
        ps.inventory -= dispatched;
        ps.backlog += order.amount - dispatched;
        
        // Contabilizamos lo despachado de forma inmediata
        despachoInmediatoAcumulado += dispatched;
        despachoTotalAcumulado += dispatched;
        
        /* traceln("PLANTA: " + ps.product + " solicitado=" + order.amount
            + " despachado=" + Math.round(dispatched)
            + " pendiente=" + Math.round(ps.backlog)); */
        break;
    }
}

// === 2. RECEPCIÓN DE INSUMOS: LLEGA EL CAMIÓN DEL PROVEEDOR ===
if (msg instanceof DeliveryMessage) {
    DeliveryMessage delivery = (DeliveryMessage) msg;
    for (ProductState ps : inventorySystem) {
        if (ps.product != delivery.product) continue;
        
        // Descontamos lo que estaba en viaje
        ps.onOrder = Math.max(0, ps.onOrder - delivery.amount);
        
        int numBatches = (int) Math.max(1, Math.round(delivery.amount / 1000.0));
        
        // Rama 1: Lavandina
        if (delivery.product == ProductType.LAVANDINA) {
            for (int b = 0; b < numBatches; b++) {
                sourceLavandina.inject();
            }
            // traceln(">>> INSUMO RECIBIDO: Inyectados " + numBatches + " lotes a Dilución de Lavandina");
        } 
        // Rama 2: Líquidos Formulados
        else {
            tipoLiquidoRecibido = delivery.product; // <- Guardamos qué producto llegó
            for (int b = 0; b < numBatches; b++) {
                sourceLiquidos.inject();
            }
            // traceln(">>> INSUMO RECIBIDO: Inyectados " + numBatches + " lotes de " + delivery.product + " a Reactores de Líquidos");
        }
        break;
    }
}]]></OnReceive>
