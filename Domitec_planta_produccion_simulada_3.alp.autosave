			<StartupCode><![CDATA[// === DASHBOARD INTERACTIVO Y SELECTOR DE ESCENARIOS (CARDS CLICKABLES) ===
// 1. Panel Contenedor de Escenarios
ShapeRectangle panelCtrl = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    20, 20, 0, 0,
    new java.awt.Color(180, 190, 200), new java.awt.Color(245, 247, 250),
    310, 210, 0, 1.5, LINE_STYLE_SOLID
);
presentation.add(panelCtrl);

ShapeText titCtrl = new ShapeText(
    SHAPE_DRAW_2D, true,
    35, 42, 0, 0,
    new java.awt.Color(33, 37, 41), "CONFIGURACION DE ESCENARIO",
    new Font("SansSerif", Font.BOLD, 12), ALIGNMENT_LEFT
);
presentation.add(titCtrl);

// BOTON / TARJETA CLICKABLE: ESCENARIO 0
ShapeRectangle btnCard0 = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    35, 55, 0, 0,
    new java.awt.Color(220, 53, 69), new java.awt.Color(254, 242, 242),
    280, 32, 0, 1.5, LINE_STYLE_SOLID
) {
    @Override
    public boolean onClick(double clickx, double clicky) {
        factorLatigoMain = 1.5;
        escalaTurnoMain = 4.2;
        domitecPlant.factorLatigo = 1.5;
        domitecPlant.escalaTurno = 4.2;
        lblEscenarioActual.setText("Escenario 0: As-Is (40h, Panico)");
        lblEscenarioActual.setColor(new java.awt.Color(220, 53, 69));
        traceln(">>> [SELECCION MANUAL] Escenario 0: Panico=1.5 | 40 hs (escala=4.2)");
        return true;
    }
};
presentation.add(btnCard0);

ShapeText txtBtn0 = new ShapeText(
    SHAPE_DRAW_2D, true,
    45, 75, 0, 0,
    new java.awt.Color(185, 28, 28), "1. As-Is (40 hs, Panico 1.5x)",
    new Font("SansSerif", Font.BOLD, 11), ALIGNMENT_LEFT
) {
    @Override
    public boolean onClick(double clickx, double clicky) {
        return btnCard0.onClick(clickx, clicky);
    }
};
presentation.add(txtBtn0);

// BOTON / TARJETA CLICKABLE: ESCENARIO 1
ShapeRectangle btnCard1 = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    35, 95, 0, 0,
    new java.awt.Color(217, 119, 6), new java.awt.Color(255, 251, 235),
    280, 32, 0, 1.5, LINE_STYLE_SOLID
) {
    @Override
    public boolean onClick(double clickx, double clicky) {
        factorLatigoMain = 1.0;
        escalaTurnoMain = 4.2;
        domitecPlant.factorLatigo = 1.0;
        domitecPlant.escalaTurno = 4.2;
        lblEscenarioActual.setText("Escenario 1: Sin Panico (40h, Racional)");
        lblEscenarioActual.setColor(new java.awt.Color(217, 119, 6));
        traceln(">>> [SELECCION MANUAL] Escenario 1: Racional=1.0 | 40 hs (escala=4.2)");
        return true;
    }
};
presentation.add(btnCard1);

ShapeText txtBtn1 = new ShapeText(
    SHAPE_DRAW_2D, true,
    45, 115, 0, 0,
    new java.awt.Color(180, 83, 9), "2. Sin Panico (40 hs, Racional 1.0x)",
    new Font("SansSerif", Font.BOLD, 11), ALIGNMENT_LEFT
) {
    @Override
    public boolean onClick(double clickx, double clicky) {
        return btnCard1.onClick(clickx, clicky);
    }
};
presentation.add(txtBtn1);

// BOTON / TARJETA CLICKABLE: ESCENARIO 2
ShapeRectangle btnCard2 = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    35, 135, 0, 0,
    new java.awt.Color(22, 163, 74), new java.awt.Color(240, 253, 244),
    280, 32, 0, 2.0, LINE_STYLE_SOLID
) {
    @Override
    public boolean onClick(double clickx, double clicky) {
        factorLatigoMain = 1.0;
        escalaTurnoMain = 3.3;
        domitecPlant.factorLatigo = 1.0;
        domitecPlant.escalaTurno = 3.3;
        lblEscenarioActual.setText("Escenario 2: Integral (51h, Racional)");
        lblEscenarioActual.setColor(new java.awt.Color(22, 163, 74));
        traceln(">>> [SELECCION MANUAL] Escenario 2: Racional=1.0 | 51 hs (escala=3.3)");
        return true;
    }
};
presentation.add(btnCard2);

ShapeText txtBtn2 = new ShapeText(
    SHAPE_DRAW_2D, true,
    45, 155, 0, 0,
    new java.awt.Color(21, 128, 61), "3. Integral (51 hs, Racional 1.0x) [RECOMENDADO]",
    new Font("SansSerif", Font.BOLD, 10), ALIGNMENT_LEFT
) {
    @Override
    public boolean onClick(double clickx, double clicky) {
        return btnCard2.onClick(clickx, clicky);
    }
};
presentation.add(txtBtn2);

ShapeText notaCtrl = new ShapeText(
    SHAPE_DRAW_2D, true,
    35, 185, 0, 0,
    new java.awt.Color(108, 117, 125), "Haz click en cualquiera de los 3 botones para",
    new Font("SansSerif", Font.ITALIC, 10), ALIGNMENT_LEFT
);
presentation.add(notaCtrl);

ShapeText notaCtrl2 = new ShapeText(
    SHAPE_DRAW_2D, true,
    35, 202, 0, 0,
    new java.awt.Color(108, 117, 125), "cambiar los parametros en tiempo real.",
    new Font("SansSerif", Font.ITALIC, 10), ALIGNMENT_LEFT
);
presentation.add(notaCtrl2);

// 2. Tarjetas de Indicadores (KPIs)
// Tarjeta Fill Rate
ShapeRectangle cardFR = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    350, 20, 0, 0,
    new java.awt.Color(200, 200, 200), new java.awt.Color(255, 255, 255),
    200, 95, 0, 1.0, LINE_STYLE_SOLID
);
presentation.add(cardFR);

ShapeText titFR = new ShapeText(
    SHAPE_DRAW_2D, true,
    360, 40, 0, 0,
    new java.awt.Color(108, 117, 125), "FILL RATE ACUMULADO",
    new Font("SansSerif", Font.BOLD, 10), ALIGNMENT_LEFT
);
presentation.add(titFR);

lblFillRate = new ShapeText(
    SHAPE_DRAW_2D, true,
    360, 75, 0, 0,
    new java.awt.Color(40, 140, 40), "--- %",
    new Font("SansSerif", Font.BOLD, 26), ALIGNMENT_LEFT
);
presentation.add(lblFillRate);

ShapeRectangle fondoGauge = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    360, 85, 0, 0,
    new java.awt.Color(220, 220, 220), new java.awt.Color(235, 235, 235),
    180, 14, 0, 1.0, LINE_STYLE_SOLID
);
presentation.add(fondoGauge);

barraGaugeFillRate = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    360, 85, 0, 0,
    null, new java.awt.Color(40, 167, 69),
    0, 14, 0, 1.0, LINE_STYLE_SOLID
);
presentation.add(barraGaugeFillRate);

// Tarjeta Backlog
ShapeRectangle cardBK = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    570, 20, 0, 0,
    new java.awt.Color(200, 200, 200), new java.awt.Color(255, 255, 255),
    200, 95, 0, 1.0, LINE_STYLE_SOLID
);
presentation.add(cardBK);

ShapeText titBK = new ShapeText(
    SHAPE_DRAW_2D, true,
    580, 40, 0, 0,
    new java.awt.Color(108, 117, 125), "PEDIDOS PENDIENTES (BACKLOG)",
    new Font("SansSerif", Font.BOLD, 10), ALIGNMENT_LEFT
);
presentation.add(titBK);

lblBacklog = new ShapeText(
    SHAPE_DRAW_2D, true,
    580, 75, 0, 0,
    new java.awt.Color(220, 53, 69), "0 cajas",
    new Font("SansSerif", Font.BOLD, 22), ALIGNMENT_LEFT
);
presentation.add(lblBacklog);

// Tarjeta Estado & Tiempo
ShapeRectangle cardTiempo = new ShapeRectangle(
    SHAPE_DRAW_2D, true,
    790, 20, 0, 0,
    new java.awt.Color(200, 200, 200), new java.awt.Color(255, 255, 255),
    240, 95, 0, 1.0, LINE_STYLE_SOLID
);
presentation.add(cardTiempo);

ShapeText titTiempo = new ShapeText(
    SHAPE_DRAW_2D, true,
    800, 40, 0, 0,
    new java.awt.Color(108, 117, 125), "ESTADO DE LA PLANTA",
    new Font("SansSerif", Font.BOLD, 10), ALIGNMENT_LEFT
);
presentation.add(titTiempo);

lblSemana = new ShapeText(
    SHAPE_DRAW_2D, true,
    800, 65, 0, 0,
    new java.awt.Color(33, 37, 41), "Semana: 0.0 de 100",
    new Font("SansSerif", Font.BOLD, 14), ALIGNMENT_LEFT
);
presentation.add(lblSemana);

lblEscenarioActual = new ShapeText(
    SHAPE_DRAW_2D, true,
    800, 92, 0, 0,
    new java.awt.Color(220, 53, 69), "Escenario 0: As-Is (40h, Panico)",
    new Font("SansSerif", Font.BOLD, 11), ALIGNMENT_LEFT
);
presentation.add(lblEscenarioActual);
]]></StartupCode>
