					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// 1. Suma al contador de producción semanal de Main (para los gráficos)
((Main)get_Main()).produccionSemanalActual += agent.cajasEquivalentes;

// 2. Suma las cajas terminadas al inventario físico de Lavandina (índice 0)
inventorySystem.get(0).inventory += agent.cajasEquivalentes;

// 3. Si hay clientes con pedidos atrasados (backlog), se despacha inmediatamente
double recovered = Math.min(inventorySystem.get(0).inventory, inventorySystem.get(0).backlog);
inventorySystem.get(0).inventory -= recovered;
inventorySystem.get(0).backlog -= recovered;
despachoTotalAcumulado += recovered;

/* traceln("LAVANDINA DISPONIBLE: " + Math.round(inventorySystem.get(0).inventory) 
        + " | Backlog restante: " + Math.round(inventorySystem.get(0).backlog)); */]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destroyEntity]]></Name>
						</Parameter>
					</Parameters>
