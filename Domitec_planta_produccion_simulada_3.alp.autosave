			<Id>1787747652909</Id>
			<Name><![CDATA[DeliveryMessage]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class DeliveryMessage implements Serializable {
    public ProductType product;
    public double amount;

    // Constructor
    public DeliveryMessage(ProductType product, double amount) {
        this.product = product;
        this.amount = amount;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1788973062213</Id>
			<Name><![CDATA[ProductState]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class ProductState implements Serializable {
    public ProductType product;
    public double inventory;
    public double backlog; 
    public double weeklyCapacity; 
    public double onOrder; // NUEVO: Insumos que ya pedimos y están en viaje

    public ProductState(ProductType product, double initialInventory, double weeklyCapacity) {
        this.product = product;
        this.inventory = initialInventory;
        this.backlog = 0;
        this.weeklyCapacity = weeklyCapacity;
        this.onOrder = 0; // Arranca en 0
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1789240004000</Id>
			<Name><![CDATA[ProductionLineState]]></Name>
			<Text><![CDATA[import java.io.Serializable;

// Flujo de cajas equivalentes en seis máquinas y seis tramos de traslado.
// Todos los tiempos de traslado y disponibilidad son supuestos explícitos.
public class ProductionLineState implements Serializable {
    public ProductType product;
    public double[] queue = new double[6];
    public double[][] transit = new double[6][4]; // 4 intervalos de 15 min = 1 h
    public int[] repairTicks = new int[6];
    public double[] processed = new double[6];
    public double finished = 0;
    public double arrivals = 0;
    public double failures = 0;

    public ProductionLineState(ProductType product) {
        this.product = product;
    }

    public double wip() {
        double result = 0;
        for (int s = 0; s < 6; s++) {
            result += queue[s];
            for (int k = 0; k < 4; k++) result += transit[s][k];
        }
        return result;
    }
}]]></Text>
		</JavaClass>
	</JavaClasses>
