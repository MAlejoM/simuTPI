		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>3399000000914</Id>
			<Name><![CDATA[ProductState]]></Name>
			<Text><![CDATA[import java.io.Serializable;

public class ProductState implements Serializable {
    public ProductType product;
    public double inventory;
    public double backlog; 
    public double weeklyCapacity; 
    public double onOrder; // NUEVO: Insumos que ya pedimos y están en viaje

    public ProductState(ProductType product, double initialInventory, double weeklyCapacity) {
        this.product = product;
        this.inventory = initialInventory;
        this.backlog = 0;
        this.weeklyCapacity = weeklyCapacity;
        this.onOrder = 0; // Arranca en 0
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>3399000000915</Id>
			<Name><![CDATA[ProductionLineState]]></Name>
			<Text><![CDATA[import java.io.Serializable;

// Flujo de cajas equivalentes en seis máquinas y seis tramos de traslado.
// Todos los tiempos de traslado y disponibilidad son supuestos explícitos.
public class ProductionLineState implements Serializable {
    public ProductType product;
    public double[] queue = new double[6];
    public double[][] transit = new double[6][4]; // 4 intervalos de 15 min = 1 h
    public int[] repairTicks = new int[6];
    public double[] processed = new double[6];
    public double finished = 0;
    public double arrivals = 0;
    public double failures = 0;

    public ProductionLineState(ProductType product) {
        this.product = product;
    }

    public double wip() {
        double result = 0;
        for (int s = 0; s < 6; s++) {
            result += queue[s];
            for (int k = 0; k < 4; k++) result += transit[s][k];
        }
        return result;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>3399000000916</Id>
			<Name><![CDATA[LavandinaAnimation]]></Name>
			<Text><![CDATA[import java.io.Serializable;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.function.DoubleSupplier;

/** Presentation state only. It never consumes random numbers or writes inventory. */
public class LavandinaAnimation implements Serializable {
    private static final long serialVersionUID = 1L;
    public static final double HOUR = 1.0 / 168.0;
    public static final double STOCK_PER_GROUP = 20000.0;
    public static final int MAX_STOCK_GROUPS = 10;
    public static final int VISIBLE_LOTS_PER_STAGE = 4;
    private final int linea;

    public LavandinaAnimation() { this(0); }
    public LavandinaAnimation(int linea) {
        if (linea < 0 || linea > 5) throw new IllegalArgumentException("Invalid product line");
        this.linea=linea;
    }
    public static java.util.Map<String,LavandinaAnimation> crearLineasLiquidos() {
        java.util.Map<String,LavandinaAnimation> result=new LinkedHashMap<>();
        String[] products={"LIQUIDO_DESINFECTANTE","LAVAVAJILLA","LIQUIDO_LAVAR_ROPA","SUAVIZANTE","DETERGENTE_CONCENTRADO"};
        for(int i=0;i<products.length;i++)result.put(products[i],new LavandinaAnimation(i+1));
        return result;
    }
    /** Reconcile presentation after Source applies the model's product type.
     * Supports either ordering of Source.onExit and downstream On enter hooks.
     * The production agent and its type are never changed here.
     */
    public static void reconciliarTipo(java.util.Map<String,LavandinaAnimation> lineas,
                                      Object agente,String producto) {
        if(lineas==null)return;
        LavandinaAnimation destino=lineas.get(producto);
        if(destino==null)return;
        Lote existente=null;
        for(LavandinaAnimation linea:lineas.values())synchronized(linea){
            Lote encontrado=linea.lotes.remove(agente);
            if(encontrado!=null)existente=encontrado;
        }
        if(existente!=null)synchronized(destino){destino.lotes.put(agente,existente);}
    }

    public interface Tiempo extends DoubleSupplier, Serializable {}

    private static final class Lote implements Serializable {
        private static final long serialVersionUID = 1L;
        int etapa;
        double desde;
        double origenX;
        double origenY;
        Tiempo duracion;
    }

    private static final class Entrega implements Serializable {
        private static final long serialVersionUID = 1L;
        double inicio;
        double cantidad;
        Entrega(double inicio, double cantidad) { this.inicio = inicio; this.cantidad = cantidad; }
    }

    private final LinkedHashMap<Object, Lote> lotes = new LinkedHashMap<>();
    private final ArrayList<Entrega> entregas = new ArrayList<>();
    private long entregasRecibidas;
    private long lotesTerminados;
    private long lotesRechazados;
    private double ultimaEntrega = Double.NaN;
    private double cantidadUltimaEntrega;

    /** Returns true only on the first actual lavandina delivery. */
    public synchronized boolean recibir(double ahora, double cantidad) {
        limpiar(ahora);
        entregas.add(new Entrega(ahora, cantidad));
        ultimaEntrega = ahora;
        cantidadUltimaEntrega = cantidad;
        entregasRecibidas++;
        return entregasRecibidas == 1;
    }

    /** Called from the existing process block's On enter action. */
    public synchronized void entrar(Object agente, int etapa, double ahora, Tiempo duracion) {
        if (etapa < 0 || etapa > 4) throw new IllegalArgumentException("Invalid production stage");
        limpiar(ahora);
        Lote lote = lotes.get(agente);
        double x = lote == null ? destinoX(0) : destinoX(lote.etapa);
        double y = lote == null ? destinoY(0) : destinoY(lote.etapa);
        if (lote == null) { lote = new Lote(); lotes.put(agente, lote); }
        lote.etapa = etapa;
        lote.desde = ahora;
        lote.origenX = x;
        lote.origenY = y;
        lote.duracion = duracion;
    }

    /** Called by the existing finished/scrap Sink, without retaining the agent. */
    public synchronized void terminar(Object agente, double ahora, boolean rechazado) {
        limpiar(ahora);
        Lote lote = lotes.remove(agente);
        if (lote == null) lote = new Lote();
        lote.etapa = rechazado ? 6 : 5;
        lote.desde = ahora;
        lote.origenX = rechazado ? destinoX(2) : finLinea();
        lote.origenY = rechazado ? destinoY(2) : alturaLinea();
        lote.duracion = null;
        // The finished agent is destroyed by Sink. Keep only an independent cue.
        lotes.put(lote, lote);
        if (rechazado) lotesRechazados++; else lotesTerminados++;
    }

    private void limpiar(double ahora) {
        lotes.entrySet().removeIf(e -> e.getValue().etapa >= 5
                && ahora - e.getValue().desde > 2 * HOUR);
        entregas.removeIf(e -> ahora - e.inicio > 2 * HOUR);
    }

    private static double clamp(double x) { return Math.max(0, Math.min(1, x)); }
    private static double smooth(double x) { x = clamp(x); return x*x*(3-2*x); }
    private static double lerp(double a, double b, double p) { return a+(b-a)*p; }
    private double inicioLinea() { return linea==0 ? 838 : 857; }
    private double finLinea() { return linea==0 ? 1185 : 1170; }
    private double alturaLinea() { return linea==0 ? 447.5 : 697+65*(linea-1); }
    private double destinoX(int etapa) {
        if(linea>0)return new double[] {488,690,680,750,finLinea(),1260,780}[etapa];
        return new double[] {488, 708, 700, 750, finLinea(), 1260, 650}[etapa];
    }
    private double destinoY(int etapa) {
        if(linea>0)return new double[] {830,700,762,835+31*(linea-1),alturaLinea(),688,770}[etapa];
        return new double[] {478, 352, 426, 512, 447.5, 347, 500}[etapa];
    }

    private double progreso(Lote lote, double ahora) {
        if (lote.etapa >= 5) return clamp((ahora-lote.desde)/HOUR);
        if (lote.duracion == null) return 0;
        double duracion = lote.duracion.getAsDouble();
        return duracion > 0 && Double.isFinite(duracion)
                ? clamp((ahora-lote.desde)/duracion) : 0;
    }

    private Lote seleccionar(int etapa, int indice, double ahora) {
        int actual = 0;
        for (Lote lote : lotes.values()) {
            if (lote.etapa != etapa) continue;
            if (etapa >= 5 && ahora-lote.desde > 2*HOUR) continue;
            if (actual++ == indice) return lote;
        }
        return null;
    }

    public synchronized boolean loteVisible(int etapa, int indice, double ahora) {
        return seleccionar(etapa, indice, ahora) != null;
    }

    public synchronized boolean cajaVisible(int etapa, int indice, double ahora) {
        Lote lote = seleccionar(etapa, indice, ahora);
        return lote != null && (etapa >= 5 || (etapa == 4 && progreso(lote, ahora) >= 0.78));
    }

    public synchronized boolean envaseVisible(int etapa, int indice, double ahora) {
        return loteVisible(etapa, indice, ahora) && !cajaVisible(etapa, indice, ahora);
    }

    public synchronized double loteX(int etapa, int indice, double ahora) {
        Lote lote = seleccionar(etapa, indice, ahora);
        if (lote == null) return destinoX(etapa);
        double p = progreso(lote, ahora);
        if (etapa == 4) return lerp(inicioLinea(), finLinea(), p);
        // The case waits on the conveyor exit; it does not fly to the warehouse.
        if (etapa == 5) return finLinea();
        if (etapa >= 5) return lerp(lote.origenX, destinoX(etapa), smooth(p));
        if (lote.duracion != null) return lerp(lote.origenX, destinoX(etapa), smooth(p/0.2)) + 12*indice;
        return destinoX(etapa) + 12*indice;
    }

    public synchronized double loteY(int etapa, int indice, double ahora) {
        Lote lote = seleccionar(etapa, indice, ahora);
        if (lote == null) return destinoY(etapa);
        double p = progreso(lote, ahora);
        if (etapa == 4 || etapa == 5) return alturaLinea();
        if (etapa >= 5) return lerp(lote.origenY, destinoY(etapa), smooth(p));
        if (lote.duracion != null) return lerp(lote.origenY, destinoY(etapa), smooth(p/0.2));
        return destinoY(etapa) + 9*(indice%2);
    }

    private Entrega entregaActual(double ahora) {
        for (int i=entregas.size()-1; i>=0; i--) {
            Entrega e = entregas.get(i);
            if (ahora >= e.inicio && ahora-e.inicio <= 2*HOUR) return e;
        }
        return null;
    }

    public synchronized boolean camionVisible(double ahora) { return entregaActual(ahora) != null; }
    public synchronized boolean descargando(double ahora) {
        Entrega e = entregaActual(ahora);
        if (e == null) return false;
        double p = (ahora-e.inicio)/(2*HOUR);
        return p >= .25 && p <= .7;
    }
    public synchronized double camionX(double ahora) {
        Entrega e = entregaActual(ahora);
        if (e == null) return 320;
        double p = (ahora-e.inicio)/(2*HOUR);
        if (p < .25) return lerp(320, 488, smooth(p/.25));
        if (p <= .7) return 488;
        return lerp(488, 320, smooth((p-.7)/.3));
    }
    public synchronized double camionY(double ahora) { return linea==0 ? 602 : 1010; }
    public synchronized double camionRotacion(double ahora) {
        Entrega e = entregaActual(ahora);
        return e != null && (ahora-e.inicio)/(2*HOUR) > .7 ? Math.PI : 0;
    }
    private double viajeDescarga(double ahora) {
        Entrega e=entregaActual(ahora);
        if(e==null)return 0;
        double p=(ahora-e.inicio)/(2*HOUR);
        if(p<.25||p>.7)return 0;
        double recorrido=(p-.25)/.45;
        return smooth(recorrido<.5 ? recorrido*2 : (1-recorrido)*2);
    }
    public synchronized double autoelevadorX(double ahora) { return lerp(528,488,viajeDescarga(ahora)); }
    public synchronized double autoelevadorY(double ahora) { return lerp(478,558,viajeDescarga(ahora)); }

    public synchronized String textoEntrega(double ahora) {
        if (entregasRecibidas == 0) return "Esperando primera entrega de lavandina | avance rapido";
        String estado = descargando(ahora) ? "Descarga" : camionVisible(ahora) ? "Camion en movimiento" : "Ultima recepcion";
        return estado+": "+Math.round(cantidadUltimaEntrega)+" cajas equivalentes | semana "
                +String.format(java.util.Locale.ROOT, "%.2f", ultimaEntrega);
    }
    public synchronized String textoProceso(int recepcion, int dilucion, int calidad, int pulmon, int envasado) {
        return "Lotes: recepcion "+recepcion+" | dilucion "+dilucion+" | calidad "+calidad
                +" | pulmon "+pulmon+" | envasado "+envasado;
    }
    public synchronized String textoResultados(double stock, double backlog) {
        return "Lavandina | stock "+Math.round(stock)+" cajas | pendientes "+Math.round(backlog)
                +" | lotes terminados "+lotesTerminados+" | rechazados "+lotesRechazados;
    }
    public static int gruposStock(double stock) {
        return (int)Math.min(MAX_STOCK_GROUPS, Math.ceil(Math.max(0, stock)/STOCK_PER_GROUP));
    }
    public static String estadoMaquina(int envasado, int esperando) {
        return envasado>0 ? "ENVASADO EN MARCHA" : esperando>0 ? "ESPERANDO ENVASADO" : "LINEA SIN LOTE";
    }
    public synchronized int lotesActivos() {
        int count=0; for (Lote lote:lotes.values()) if (lote.etapa < 5) count++; return count;
    }
    public synchronized int cantidadEtapa(int etapa) {
        int count=0; for(Lote lote:lotes.values())if(lote.etapa==etapa)count++;return count;
    }
    public synchronized long lotesTerminados() { return lotesTerminados; }
    public synchronized double progresoEtapa(int etapa,double ahora) {
        int count=0;double sum=0;
        for(Lote lote:lotes.values())if(lote.etapa==etapa){sum+=progreso(lote,ahora);count++;}
        return count==0 ? 0 : sum/count;
    }
    public static LavandinaAnimation recepcionActiva(java.util.Map<String,LavandinaAnimation> lineas,double ahora) {
        if(lineas!=null)for(LavandinaAnimation linea:lineas.values())if(linea.camionVisible(ahora))return linea;
        return null;
    }
}
]]></Text>
