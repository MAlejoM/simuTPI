// traceln("⚠️ QC LÍQUIDOS: Lote de " + agent.tipo + " retenido por viscosidad/tensoactivo.");
if (agent.tipo != null && animacionesLiquidos.containsKey(agent.tipo.name())) animacionesLiquidos.get(agent.tipo.name()).terminar(agent, time(), true);]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destroyEntity]]></Name>
						</Parameter>
