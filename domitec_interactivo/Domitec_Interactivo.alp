			<AdditionalClassCode><![CDATA[public ConfiguracionDomitec cfg = new ConfiguracionDomitec();
public RegistroCorrida registro = new RegistroCorrida();
public int vistaActiva = 1, escenarioActivo = 0, perfilCanal = 0, perfilProducto = 0;
public int metricaIC = 0;
public String mensajeUI = "Los cambios se aplican a los proximos pedidos y procesos.";
private com.anylogic.engine.presentation.ShapeEmbeddedObjectPresentation vistaPlanta3D;
private com.anylogic.engine.markup.Level nivelPlanta3D;
public double[] demandaPorSemana=new double[100], ordenesPorSemana=new double[100], produccionPorSemana=new double[100];

public void iniciarInterfaz() {
    if(getModelElementsShape()!=null)getModelElementsShape().setVisible(false);
    cfg = configuracionInicial == null ? new ConfiguracionDomitec() : configuracionInicial.copiarDeep();
    if (numeroEscenario >= 0) cfg = cfg.escenario(numeroEscenario);
    else cfg.factLatigo = factorLatigoMain;
    cfg.validar();
    escenarioActivo = numeroEscenario >= 0 ? numeroEscenario : (cfg.factLatigo <= 1 ? 1 : 0);
    aplicarConfiguracion(cfg, false);
    if (esComparacion) { muestrearWip.reset(); return; }
    nivelPlanta3D = new com.anylogic.engine.markup.Level(this, "planta3D", SHAPE_DRAW_3D, 0);
    vistaPlanta3D = new com.anylogic.engine.presentation.ShapeEmbeddedObjectPresentation(
        this, SHAPE_DRAW_3D, true, 0, 0, 0, 0, false, false, domitecPlant);
    vistaPlanta3D.setVisible(false);
    nivelPlanta3D.add(vistaPlanta3D);
    nivelPlanta3D.initialize();
    presentation.add(nivelPlanta3D);
    seleccionarPerfil(0, 0);
    sincronizarControles();
    mostrarVista(1);
    restablecerCamara();
}

public void mostrarVista(int vista) {
    if (vista < 0 || vista > 3) throw new IllegalArgumentException("Vista inexistente");
    vistaActiva = vista;
    // Draw modes are fixed at construction in AnyLogic. Tabs only change visibility.
    if (vistaPlanta3D != null) vistaPlanta3D.setVisible(vista == 1);
}

public double stockProducto(int producto) {
    for (ProductState p : domitecPlant.inventorySystem)
        if (ConfiguracionDomitec.indice(p.product.name()) == producto) return p.inventory;
    return 0;
}
public double backlogProducto(int producto) {
    for (ProductState p : domitecPlant.inventorySystem)
        if (ConfiguracionDomitec.indice(p.product.name()) == producto) return p.backlog;
    return 0;
}
public int lotesEtapa(int producto, int etapa) {
    DomitecPlant p = (DomitecPlant) domitecPlant;
    if (producto == 0) {
        switch (etapa) {
            case 0: return p.queueMateriaPrima.size();
            case 1: return p.delayDilucion.size();
            case 2: return p.delayQCLavandina.size();
            case 3: return p.queueTanquePulmon.size();
            case 4: return p.delayEnvasado.size();
        }
    }
    com.anylogic.libraries.processmodeling.Queue<? extends com.anylogic.engine.Agent> tanque;
    com.anylogic.libraries.processmodeling.Delay<? extends com.anylogic.engine.Agent> envasado;
    switch(producto) {
        case 1: tanque=p.tankDesinfectante; envasado=p.delayEnvasadoDesinfectante; break;
        case 2: tanque=p.tankLavavajilla; envasado=p.delayEnvasadoLavavajilla; break;
        case 3: tanque=p.tankLavarropa; envasado=p.delayEnvasadoLavarropa; break;
        case 4: tanque=p.tankSuavizante; envasado=p.delayEnvasadoSuavizante; break;
        case 5: tanque=p.tankDetergente; envasado=p.delayEnvasadoDetergente; break;
        default: return 0;
    }
    if(etapa==3)return tanque.size();
    if(etapa==4)return envasado.size();
    int n=0;
    if(etapa==0)for(int i=0;i<p.queueEsperaElaboracion.size();i++)if(ConfiguracionDomitec.indice(p.queueEsperaElaboracion.get(i).tipo.name())==producto)n++;
    if(etapa==1)for(int i=0;i<p.delayReactoresLiquidos.size();i++)if(ConfiguracionDomitec.indice(p.delayReactoresLiquidos.get(i).tipo.name())==producto)n++;
    if(etapa==2)for(int i=0;i<p.delayQCLiquidos.size();i++)if(ConfiguracionDomitec.indice(p.delayQCLiquidos.get(i).tipo.name())==producto)n++;
    return n;
}

public void elegirEscenario(int escenario) {
    try {
        ConfiguracionDomitec nueva = cfg.escenario(escenario);
        aplicarConfiguracion(nueva, true);
        escenarioActivo = escenario;
        sincronizarControles();
        mensajeUI = "Escenario " + escenario + " aplicado. Los lotes en proceso conservan su tiempo ya sorteado.";
    } catch (IllegalArgumentException error) { mensajeUI = error.getMessage(); }
}

public void aplicarConfiguracion(ConfiguracionDomitec nueva, boolean enVivo) {
    nueva.validar();
    DomitecPlant p = (DomitecPlant) domitecPlant;
    if (enVivo && (nueva.reactores < p.delayReactoresLiquidos.size()
            || nueva.cola < p.queueEsperaElaboracion.size()
            || nueva.tanque < Math.max(p.queueTanquePulmon.size(),
                Math.max(p.tankDesinfectante.size(), Math.max(p.tankLavavajilla.size(),
                Math.max(p.tankLavarropa.size(), Math.max(p.tankSuavizante.size(),p.tankDetergente.size())))))))
        throw new IllegalArgumentException("La capacidad nueva no puede ser menor que los lotes presentes.");
    if(enVivo && nueva.maxLotesEnProceso*1000.0 < p.materiales.wip())
        throw new IllegalArgumentException("El limite de liberacion no puede ser menor que el WIP presente.");
    cfg = nueva.copiarDeep();
    factorLatigoMain = cfg.factLatigo;
    escalaTurnoMain = cfg.escalaTurno();
    p.factorLatigo = factorLatigoMain;
    p.escalaTurno = escalaTurnoMain;
    p.delayReactoresLiquidos.set_capacity(cfg.reactores);
    p.queueEsperaElaboracion.set_capacity(cfg.cola);
    p.queueTanquePulmon.set_capacity(cfg.tanque);
    p.tankDesinfectante.set_capacity(cfg.tanque);
    p.tankLavavajilla.set_capacity(cfg.tanque);
    p.tankLavarropa.set_capacity(cfg.tanque);
    p.tankSuavizante.set_capacity(cfg.tanque);
    p.tankDetergente.set_capacity(cfg.tanque);
    for (ProductState ps : p.inventorySystem) {
        int i = ConfiguracionDomitec.indice(ps.product.name());
        ps.weeklyCapacity = cfg.horas * cfg.rate[i] * cfg.capacidadFactor * cfg.mejoraEscenario / cfg.tiemposFactor;
    }
}

public void seleccionarPerfil(int canal, int producto) {
    perfilCanal=canal; perfilProducto=producto;
    uiMedia=cfg.medias[canal][producto]; uiDesvio=cfg.desvios[canal][producto];
    uiLead=cfg.leadDias[producto];uiCobertura=cfg.cobertura[producto];uiRate=cfg.rate[producto];
    if (!esComparacion) {
        campoMedia.setValueToDefault();campoDesvio.setValueToDefault();
        campoLead.setValueToDefault();campoCobertura.setValueToDefault();campoRate.setValueToDefault();
    }
}

public void sincronizarControles() {
    uiLatigo=cfg.factLatigo;uiHoras=cfg.horas;uiMermaLav=cfg.mermaLav*100;uiMermaLiq=cfg.mermaLiq*100;
    uiTiempo=cfg.tiemposFactor;uiCapacidad=cfg.capacidadFactor*cfg.mejoraEscenario;uiWarmup=cfg.calentamiento;
    uiReactores=cfg.reactores;uiCola=cfg.cola;uiTanque=cfg.tanque;
    uiEspera=cfg.esperaPedidoDias;uiMaxWip=cfg.maxLotesEnProceso;
    if (!esComparacion) {
        campoLatigo.setValueToDefault();campoHoras.setValueToDefault();campoMermaLav.setValueToDefault();
        campoMermaLiq.setValueToDefault();campoTiempo.setValueToDefault();campoCapacidad.setValueToDefault();
        campoWarmup.setValueToDefault();campoReactores.setValueToDefault();campoCola.setValueToDefault();campoTanque.setValueToDefault();
        campoEspera.setValueToDefault();campoMaxWip.setValueToDefault();
    }
}

public void guardarDemanda() {
    try {
        ConfiguracionDomitec nueva=cfg.copiarDeep();
        nueva.medias[perfilCanal][perfilProducto]=uiMedia;
        nueva.desvios[perfilCanal][perfilProducto]=uiDesvio;
        aplicarConfiguracion(nueva,true);escenarioActivo=3;
        mensajeUI="Media y desvio actualizados para "+nombreCanal(perfilCanal)+" / "+nombreProducto(perfilProducto)+".";
    } catch(IllegalArgumentException error){mensajeUI=error.getMessage();}
}

public void guardarPlanta() {
    try {
        ConfiguracionDomitec nueva=cfg.copiarDeep();
        nueva.factLatigo=uiLatigo;nueva.horas=uiHoras;
        nueva.leadDias[perfilProducto]=uiLead;nueva.cobertura[perfilProducto]=uiCobertura;nueva.rate[perfilProducto]=uiRate;
        nueva.capacidadFactor=uiCapacidad;nueva.tiemposFactor=uiTiempo;
        nueva.mejoraEscenario=1.0; // The editable multiplier is the effective one shown in the form.
        nueva.mermaLav=uiMermaLav/100;nueva.mermaLiq=uiMermaLiq/100;
        nueva.reactores=uiReactores;nueva.cola=uiCola;nueva.tanque=uiTanque;nueva.calentamiento=uiWarmup;
        nueva.esperaPedidoDias=uiEspera;nueva.maxLotesEnProceso=uiMaxWip;
        aplicarConfiguracion(nueva,true);escenarioActivo=3;
        mensajeUI="Configuracion personalizada aplicada. Se conservan los procesos en curso.";
    } catch(IllegalArgumentException error){mensajeUI=error.getMessage();}
}

public double demandaComun(String canal, ProductType producto) {
    int c=canal.equals("Maxiconsumo")?0:canal.equals("Grandes Clientes")?1:2;
    int p=ConfiguracionDomitec.indice(producto.name());
    long semana=(long)Math.floor(time()+1e-8);
    double q=Math.round(DatosOperativos.demanda(semillaReplica,c,p,semana,cfg.medias[c][p],cfg.desvios[c][p]));
    registro.entrada(c,p,semana,q);
    if(semana>=0 && semana<100)demandaPorSemana[(int)semana]+=q;
    return q;
}

public double stockActual(){double x=0;for(ProductState p:domitecPlant.inventorySystem)x+=p.inventory;return x;}
public double backlogActual(){double x=0;for(ProductState p:domitecPlant.inventorySystem)x+=p.backlog;return x;}
public double wipActual(){
    return ((DomitecPlant)domitecPlant).materiales.wip();
}
public double insumosActual(){return ((DomitecPlant)domitecPlant).materiales.materiasPrimas();}
public double demandaMediaProducto(int p){double x=0;for(int c=0;c<3;c++)x+=cfg.medias[c][p];return x;}
public double canceladasActual(){return registro.canceladoTotal(0);}
public ComparacionEscenarios.Resultado resultadoFinal(int escenario){
    return new ComparacionEscenarios.Resultado(semillaReplica,escenario,100*registro.fillRate(cfg.calentamiento),
        backlogActual(),stockActual(),registro.bw(cfg.calentamiento),registro.produccionTotal(cfg.calentamiento),
        registro.canceladoTotal(cfg.calentamiento),((DomitecPlant)domitecPlant).materiales.picoWip(),insumosActual());
}
public String nombreProducto(int i){return new String[]{"Lavandina","Desinfectante","Lavavajilla","Lavarropa","Suavizante","Detergente"}[i];}
public String nombreCanal(int i){return new String[]{"Maxiconsumo","Grandes clientes","Red propia"}[i];}
public String numero(double x){return String.format(java.util.Locale.ROOT,"%,.0f",x);}
public String escenarioTexto(){return escenarioActivo==3?"Personalizado":new String[]{"0 - Base 24x7","1 - Sin panico 24x7","2 - Rendimiento +27.5% (hipotesis)"}[escenarioActivo];}
public String perfilTexto(){return nombreCanal(perfilCanal)+" / "+nombreProducto(perfilProducto);}

public void ejecutarComparacion() {
    try {
        SesionEstudio.preparar(cfg,carpetaResultados);
        mensajeUI="Configuracion guardada. Ejecutar Comparacion_100x3 desde el menu Run de AnyLogic.";
        getExperiment().getExperimentHost().showMessageDialog(
            "Parametros personalizados guardados.\n\n1. Cerra esta ejecucion.\n2. Abri Comparacion_100x3 y pulsa Usar guardados y ejecutar.\n3. Al terminar, volve a Estadisticas y pulsa Leer ultimos IC.\n\nPara comparar los escenarios predeterminados podes abrir Comparacion_100x3 directamente, sin preparar nada.");
    } catch(RuntimeException error){mensajeUI=error.getMessage();}
}
public void cargarUltimosIC(){
    try{SesionEstudio.leerUltimoEstudio(carpetaResultados);mensajeUI=SesionEstudio.estado;}
    catch(RuntimeException error){mensajeUI=error.getMessage();}
}
public void restablecerCamara(){
    double altura=1300;
    double inclinacion=Math.toRadians(55);
    ventanaPlanta3D.setCamera(new com.anylogic.engine.presentation.Camera3D(
        920,605+altura/Math.tan(inclinacion),altura,inclinacion,-Math.PI/2),false,0L);
}
public void vistaSuperior(){
    ventanaPlanta3D.setCamera(new com.anylogic.engine.presentation.Camera3D(920,605,1300,Math.PI/2,0),false,0L);
}
public String tablaIC(){
    ComparacionEscenarios datos=SesionEstudio.ultimoResultado;
    if(datos==null)return "Sin estudio completo.\nEjecutar las 100 ternas.\nLos IC se publican con 100 pares.\nNo se fuerza que excluyan el cero.";
    String metrica=new String[]{"fillRate","backlog","bw","stock","produccion"}[metricaIC];
    StringBuilder s=new StringBuilder("IC 95% PAREADOS | "+metrica+"\n\n");
    for(int[] par:new int[][]{{0,1},{0,2},{1,2}}){
        ComparacionEscenarios.PairCI95 c=datos.pairCI95(par[0],par[1],metrica);
        s.append("Esc ").append(par[0]).append(" - ").append(par[1]).append(" | n=").append(c.n).append("\n");
        s.append(String.format(java.util.Locale.ROOT,"Delta: %.3f\n[%.3f ; %.3f]\n",c.media,c.inferior,c.superior));
        s.append(c.inferior>0||c.superior<0?"Excluye cero\n\n":"Incluye cero\n\n");
    }return s.toString();
}
public void registrarPedido(ProductType tipo,double cantidad,double inmediato){
    int p=ConfiguracionDomitec.indice(tipo.name());
    if(inmediato>0)registro.pedido(p,time(),inmediato,true);
    if(cantidad-inmediato>0)registro.pedido(p,time(),cantidad-inmediato,false);
}
public void registrarProduccion(ProductType tipo,double cantidad){
    registro.produccion(time(),cantidad);int s=(int)Math.floor(time());
    if(s>=0&&s<100)produccionPorSemana[s]+=cantidad;
}
public void observarSemana(){
    ((DomitecPlant)domitecPlant).caducarPedidos();
    ((DomitecPlant)domitecPlant).materiales.verificar();
    int s=(int)Math.floor(time());
    if(s>=0&&s<100){
        registro.semanal(s,demandaPorSemana[s],ordenesPorSemana[s],produccionPorSemana[s],stockActual(),backlogActual(),wipActual());
        dsDemanda.add(time(),demandaPorSemana[s]);dsOrdenes.add(time(),ordenesPorSemana[s]);
        dsProduccionSemanal.add(time(),produccionPorSemana[s]);dsBacklog.add(time(),backlogActual());
    }
    demandaSemanalActual=0;ordenesSemanalActual=0;produccionSemanalActual=0;
}
public void actualizarWipGrafico(){if(!esComparacion)dsWip.add(time(),wipActual());}
public void validarCorridaCompleta(){
    DomitecPlant p=(DomitecPlant)domitecPlant;
    p.caducarPedidos();p.materiales.verificar();
    double demanda=registro.demandaTotal(0);
    double cierre=demanda*registro.fillRate(0)+registro.canceladoTotal(0)+registro.pendienteTotal(0);
    if(Math.abs(demanda-cierre)>1e-5 || Math.abs(backlogActual()-registro.pendienteTotal(0))>1e-5)
        throw new IllegalStateException("No reconcilia demanda = entregada + cancelada + pendiente");
    if(wipActual()>cfg.maxLotesEnProceso*1000.0+1e-5)
        throw new IllegalStateException("WIP supera las tarjetas de liberacion");
    if(time()<99.99999 || registro.numeroSemanas()!=100 || registro.numeroEntradas()!=1800)
        throw new IllegalStateException("Corrida incompleta: tiempo="+time()+", semanas="+registro.numeroSemanas()+"/100, entradas="+registro.numeroEntradas()+"/1800, semilla="+semillaReplica+", escenario="+numeroEscenario+". Ejecutar Comparacion_100x3 desde el menu Run de AnyLogic y dejarlo terminar.");
}

// GUIA_PLANTA: presentation state only; it never changes production.
public int sector3DActivo=0;
public String nombreSector3D(){return (new String[]{"1. Recepción Parque","2. Dilución y calidad","3. Envasado Parque","4. Depósito Parque","5. Recepción Vicentin","6. Reactores y calidad","7. Tanques pulmón","8. Envasado Vicentin","9. Depósito Vicentin"})[sector3DActivo];}
public String descripcionSector3D(){return (new String[]{"Materias primas e insumos\npara la línea de lavandina.\nLos lotes recibidos esperan\nantes de la dilución.","Se diluye la lavandina y se\ncontrola su calidad. Los lotes\naprobados pasan al pulmón;\nlos rechazados son merma.","Envases, llenado y cierre\nhasta obtener cajas. Los\nequipos representan la línea\nde envasado de lavandina.","Almacena lavandina terminada.\nEl stock se usa para despachar.\nLo que no puede atenderse\nqueda como pedido pendiente.","Insumos de los líquidos:\nbases, tensoactivos, esencias\ny materiales de envase. Los\nlotes esperan elaboración.","Elaboración de los líquidos\nen reactores compartidos.\nDespués se controla la calidad\ny se separa la merma.","Guardan semielaborado\naprobado, separado por\nproducto, mientras espera\nsu turno de envasado.","Cinco líneas: desinfectante,\nlavavajilla, lavarropa,\nsuavizante y detergente.\nTransforman los lotes en cajas.","Almacena las cajas terminadas\nde los cinco líquidos. El\ndespacho reduce stock y se\nregistra la demanda pendiente."})[sector3DActivo];}
public void enfocarSector3D(){
    double[] c=(new double[][]{{485.0,427.5},{707.5,427.5},{1012.5,427.5},{1337.5,427.5},{485.0,815.0},{722.5,710.0},{722.5,887.5},{1025.0,815.0},{1337.5,815.0}})[sector3DActivo];
    ventanaPlanta3D.setCamera(new com.anylogic.engine.presentation.Camera3D(c[0],c[1],600,Math.PI/2,0),false,0L);
}
