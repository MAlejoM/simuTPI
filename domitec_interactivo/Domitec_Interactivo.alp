		<JavaClass>
			<Id>3699000001145</Id>
			<Name><![CDATA[OperarioAnimation]]></Name>
			<Text><![CDATA[/** Deterministic presentation routes. Time is in model weeks; no events or RNG. */
public final class OperarioAnimation {
    private OperarioAnimation() {}
    private static final double MINUTES_PER_WEEK = 7 * 24 * 60;
    private static final double CYCLE = 180;

    private static double phase(double time, int person) {
        return ((time * MINUTES_PER_WEEK + person * 43) % CYCLE + CYCLE) % CYCLE;
    }

    public static double progress(double time, int person) {
        double p = phase(time, person);
        if (p < 90) return 0;              // Work at the first station.
        if (p < 110) return (p - 90) / 20; // Walk out.
        if (p < 150) return 1;             // Pause at the second station.
        if (p < 170) return (170 - p) / 20;
        return 0;
    }

    public static boolean walking(double time, int person) {
        double p = phase(time, person);
        return (p >= 90 && p < 110) || (p >= 150 && p < 170);
    }

    public static double coordinate(double time, int person, double origin, double delta) {
        return origin + delta * progress(time, person);
    }

    public static double rotation(double time, int person, double dx, double dy) {
        double heading = Math.atan2(dy, dx);
        return heading + (phase(time, person) >= 150 ? Math.PI : 0);
    }

    public static String pose(double time, int person) {
        if (!walking(time, person)) return "idle";
        // The library supplies static left/right walking poses; alternate them.
        return ((long)Math.floor(time * MINUTES_PER_WEEK / 3.0) & 1L) == 0
                ? "walk_left" : "walk_right";
    }
}
]]></Text>
		</JavaClass>
	<JavaClass><Id>3699000001146</Id><Name>ComparacionEscenarios</Name><Text><![CDATA[import java.io.Serializable;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/**
 * Acumulador puro Java para comparar tres escenarios con numeros aleatorios
 * comunes. No depende de AnyLogic ni consume estado de un generador global.
 */
public final class ComparacionEscenarios implements Serializable {
    private static final long serialVersionUID = 1L;
    public static final int ESCENARIOS = 3;
    public static final int SEMILLA_MIN = 1;
    public static final int SEMILLA_MAX = 100;

    /** Una observacion final (o ya agregada para la ventana elegida) de una corrida. */
    public static final class Resultado implements Serializable {
        private static final long serialVersionUID = 1L;
        public final int seed;
        public final int escenario;
        public final double fillRate;
        public final double backlog;
        public final double stock;
        public final double bw;
        public final double produccion;

        public Resultado(int seed, int escenario, double fillRate, double backlog,
                         double stock, double bw, double produccion) {
            if (seed < SEMILLA_MIN || seed > SEMILLA_MAX)
                throw new IllegalArgumentException("seed debe estar entre 1 y 100");
            if (escenario < 0 || escenario >= ESCENARIOS)
                throw new IllegalArgumentException("escenario debe ser 0, 1 o 2");
            exigirFinito("fillRate", fillRate);
            exigirFinito("backlog", backlog);
            exigirFinito("stock", stock);
            exigirFinito("bw", bw);
            exigirFinito("produccion", produccion);
            this.seed = seed;
            this.escenario = escenario;
            this.fillRate = fillRate;
            this.backlog = backlog;
            this.stock = stock;
            this.bw = bw;
            this.produccion = produccion;
        }

        private static void exigirFinito(String nombre, double valor) {
            if (Double.isNaN(valor) || Double.isInfinite(valor))
                throw new IllegalArgumentException(nombre + " debe ser finito");
        }
    }

    /** IC t bilateral 95% de la diferencia pareada (primer escenario menos segundo). */
    public static final class PairCI95 implements Serializable {
        private static final long serialVersionUID = 1L;
        public final int escenarioA, escenarioB, n, df;
        public final double media, desviacion, sem, tCritico, inferior, superior;
        public final boolean disponible;

        private PairCI95(int a, int b, int n, double media, double desviacion,
                         double tCritico, double inferior, double superior) {
            this.escenarioA = a; this.escenarioB = b; this.n = n; this.df = n - 1;
            this.media = media; this.desviacion = desviacion;
            this.sem = n > 0 ? desviacion / Math.sqrt(n) : Double.NaN;
            this.tCritico = tCritico; this.inferior = inferior; this.superior = superior;
            this.disponible = n >= 2;
        }
    }

    private final Map<Long, Resultado> resultados = new LinkedHashMap<Long, Resultado>();

    public void agregar(Resultado resultado) {
        if (resultado == null) throw new IllegalArgumentException("resultado no puede ser null");
        long key = clave(resultado.seed, resultado.escenario);
        if (resultados.containsKey(key))
            throw new IllegalArgumentException("Ya existe resultado para seed=" + resultado.seed
                    + ", escenario=" + resultado.escenario);
        resultados.put(key, resultado);
    }

    public int getCount() { return resultados.size(); }
    public int cantidadResultados() { return getCount(); }

    /** Lista plana ordenada por seed y luego escenario, sin exponer el almacenamiento. */
    public List<Resultado> ternasOrdenadas() {
        List<Resultado> lista = new ArrayList<Resultado>(resultados.values());
        Collections.sort(lista, new Comparator<Resultado>() {
            public int compare(Resultado a, Resultado b) {
                int c = Integer.compare(a.seed, b.seed);
                return c != 0 ? c : Integer.compare(a.escenario, b.escenario);
            }
        });
        return Collections.unmodifiableList(lista);
    }

    /** Solo devuelve ternas completas; cada tripleta está ordenada por escenario. */
    public List<List<Resultado>> getTernasOrdenadas() {
        Map<Integer, Resultado[]> porSeed = new LinkedHashMap<Integer, Resultado[]>();
        for (Resultado r : resultados.values()) {
            Resultado[] terna = porSeed.get(r.seed);
            if (terna == null) { terna = new Resultado[ESCENARIOS]; porSeed.put(r.seed, terna); }
            terna[r.escenario] = r;
        }
        List<Integer> semillas = new ArrayList<Integer>(porSeed.keySet());
        Collections.sort(semillas);
        List<List<Resultado>> salida = new ArrayList<List<Resultado>>();
        for (Integer seed : semillas) {
            Resultado[] t = porSeed.get(seed);
            if (t[0] != null && t[1] != null && t[2] != null) {
                List<Resultado> tripleta = new ArrayList<Resultado>(ESCENARIOS);
                Collections.addAll(tripleta, t);
                salida.add(Collections.unmodifiableList(tripleta));
            }
        }
        return Collections.unmodifiableList(salida);
    }

    /** ICs para las tres parejas y las cinco metricas disponibles. */
    public Map<String, PairCI95> pairCI95() {
        Map<String, PairCI95> salida = new LinkedHashMap<String, PairCI95>();
        int[][] parejas = {{0,1},{0,2},{1,2}};
        String[] metricas = {"fillRate", "backlog", "stock", "bw", "produccion"};
        for (int[] p : parejas) for (String metrica : metricas)
            salida.put("escenario" + p[0] + "-" + p[1] + "." + metrica,
                    pairCI95(p[0], p[1], metrica));
        return Collections.unmodifiableMap(salida);
    }

    public PairCI95 pairCI95(int escenarioA, int escenarioB, String metrica) {
        validarPareja(escenarioA, escenarioB);
        final int a = escenarioA, b = escenarioB;
        List<Double> diferencias = new ArrayList<Double>();
        for (int seed = SEMILLA_MIN; seed <= SEMILLA_MAX; seed++) {
            Resultado ra = resultados.get(clave(seed, a));
            Resultado rb = resultados.get(clave(seed, b));
            if (ra != null && rb != null)
                diferencias.add(valor(ra, metrica) - valor(rb, metrica));
        }
        int n = diferencias.size();
        if (n == 0) return new PairCI95(a,b,0,Double.NaN,Double.NaN,Double.NaN,Double.NaN,Double.NaN);
        double media = 0.0;
        for (double d : diferencias) media += d;
        media /= n;
        double suma = 0.0;
        for (double d : diferencias) { double e = d - media; suma += e * e; }
        double sd = n > 1 ? Math.sqrt(suma / (n - 1)) : Double.NaN;
        if (n < 2) return new PairCI95(a,b,n,media,sd,Double.NaN,Double.NaN,Double.NaN);
        double t = tCritico95(n - 1);
        double margen = t * sd / Math.sqrt(n);
        // Asegura CI exactamente de ancho cero para diferencias constantes.
        if (sd == 0.0) margen = 0.0;
        return new PairCI95(a,b,n,media,sd,t,media-margen,media+margen);
    }

    /** Error t bilateral 95% por df; tabla exacta en df=1..30 y puntos usuales. */
    public static double tCritico95(int df) {
        if (df < 1) throw new IllegalArgumentException("df debe ser >= 1");
        double[] t = {0,12.7062047364,4.30265272975,3.18244630528,2.77644510520,
            2.57058183564,2.44691184879,2.36462425101,2.30600413503,2.26215716285,
            2.22813885196,2.20098516008,2.17881282966,2.16036865646,2.14478668792,
            2.13144954556,2.11990529922,2.10981557783,2.10092204024,2.09302405441,
            2.08596344727,2.07961384473,2.07387306790,2.06865761042,2.06389856163,
            2.05953855275,2.05552943864,2.05183051648,2.04840714180,2.04522964213,
            2.04227245630};
        if (df <= 30) return t[df];
        if (df == 40) return 2.02107539031;
        if (df == 60) return 2.00029782201;
        if (df == 99) return 1.9842169515;
        if (df >= 120) return 1.95996398454;
        // Interpolacion lineal de cuantiles tabulados de Student.
        int[] dfs = {30,40,60,99,120};
        double[] ts = {2.04227245630,2.02107539031,2.00029782201,1.9842169515,1.97993040505};
        for (int i=0; i<dfs.length-1; i++) if (df < dfs[i+1]) {
            double f = (df-dfs[i])/(double)(dfs[i+1]-dfs[i]);
            return ts[i] + f*(ts[i+1]-ts[i]);
        }
        return 1.95996398454;
    }

    /** Uniforme determinista U[0,1), separado por seed/canal/producto/indice/etapa. */
    public static double uniforme(long semilla, int canal, int producto, long indice, int etapa) {
        long h = mezclar(semilla ^ 0x9E3779B97F4A7C15L);
        h = mezclar(h ^ (((long) canal) * 0xD1B54A32D192ED03L));
        h = mezclar(h ^ (((long) producto) * 0x94D049BB133111EBL));
        h = mezclar(h ^ (indice * 0xBF58476D1CE4E5B9L));
        h = mezclar(h ^ (((long) etapa) * 0xDB4F0B9175AE2165L));
        return (h >>> 11) * 0x1.0p-53;
    }

    /** Normal determinista por Box-Muller con canal de salt distinto del uniforme publico. */
    public static double normal(long seed, int canal, int producto, long semana,
                                double media, double desvio) {
        if (Double.isNaN(media) || Double.isInfinite(media) || Double.isNaN(desvio)
                || Double.isInfinite(desvio) || desvio < 0.0)
            throw new IllegalArgumentException("media finita y desvio finito no negativo requeridos");
        double u1 = uniforme(seed ^ 0xA0761D6478BD642FL, canal, producto, semana, 0x4E31);
        double u2 = uniforme(seed ^ 0xE7037ED1A0B428DBL, canal, producto, semana, 0x4E32);
        if (u1 == 0.0) u1 = 0x1.0p-53;
        return media + desvio * Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
    }

    public static double triangular(long seed, int producto, long lote, int etapa,
                                    double minimo, double moda, double maximo) {
        if (!finito(minimo) || !finito(moda) || !finito(maximo)
                || minimo > moda || moda > maximo || minimo == maximo)
            throw new IllegalArgumentException("Se requiere minimo <= moda <= maximo y rango positivo");
        double u = uniforme(seed, 0x545249, producto, lote, etapa);
        double corte = (moda - minimo) / (maximo - minimo);
        if (u < corte) return minimo + Math.sqrt(u * (maximo-minimo) * (moda-minimo));
        return maximo - Math.sqrt((1.0-u) * (maximo-minimo) * (maximo-moda));
    }

    /** CSV serializable en memoria (sin escritura a disco). */
    public static String toCsv(ComparacionEscenarios datos) {
        StringBuilder b = new StringBuilder("seed,escenario,fillRate,backlog,stock,bw,produccion\n");
        for (Resultado r : datos.ternasOrdenadas())
            b.append(r.seed).append(',').append(r.escenario).append(',').append(r.fillRate).append(',')
             .append(r.backlog).append(',').append(r.stock).append(',').append(r.bw).append(',')
             .append(r.produccion).append('\n');
        return b.toString();
    }

    public String resumen() {
        StringBuilder b = new StringBuilder("Resultados: ").append(getCount()).append("; ternas completas: ")
                .append(getTernasOrdenadas().size()).append('\n');
        for (Map.Entry<String, PairCI95> e : pairCI95().entrySet()) {
            PairCI95 ci = e.getValue();
            b.append(e.getKey()).append(" n=").append(ci.n);
            if (ci.disponible) b.append(" media=").append(ci.media).append(" IC95%=[")
                    .append(ci.inferior).append(", ").append(ci.superior).append(']');
            else b.append(" (minimo n=2)");
            b.append('\n');
        }
        return b.toString();
    }

    private static boolean finito(double d) { return !Double.isNaN(d) && !Double.isInfinite(d); }
    private static long clave(int seed, int escenario) { return (((long)seed) << 32) | (escenario & 0xffffffffL); }
    private static void validarPareja(int a, int b) {
        if (a < 0 || a >= ESCENARIOS || b < 0 || b >= ESCENARIOS || a == b)
            throw new IllegalArgumentException("La pareja requiere dos escenarios distintos entre 0 y 2");
    }
    private static double valor(Resultado r, String metrica) {
        if ("fillRate".equals(metrica)) return r.fillRate;
        if ("backlog".equals(metrica)) return r.backlog;
        if ("stock".equals(metrica)) return r.stock;
        if ("bw".equals(metrica)) return r.bw;
        if ("produccion".equals(metrica)) return r.produccion;
        throw new IllegalArgumentException("Metrica desconocida: " + metrica);
    }
    private static long mezclar(long z) {
        z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9L;
        z = (z ^ (z >>> 27)) * 0x94D049BB133111EBL;
        return z ^ (z >>> 31);
    }
}
]]></Text></JavaClass><JavaClass><Id>3699000001147</Id><Name>ConfiguracionDomitec</Name><Text><![CDATA[import java.io.Serializable;
import java.util.Locale;

/** Parametros editables y validables del modelo Domitec, independiente de AnyLogic. */
public final class ConfiguracionDomitec implements Serializable {
    private static final long serialVersionUID = 1L;
    public static final String[] PRODUCTOS = {
        "LAVANDINA", "LIQUIDO_DESINFECTANTE", "LAVAVAJILLA",
        "LIQUIDO_LAVAR_ROPA", "SUAVIZANTE", "DETERGENTE_CONCENTRADO"
    };

    public double[][] medias = {
        {9379,6171,5104,2184,1765,1046},
        {3073,4568,2081,312,516,0},
        {13829,6780,5575,2931,2222,1169}
    };
    public double[][] desvios = {
        {11162,8216,6055,3587,2348,1825},
        {2665,5515,2215,482,809,0},
        {6751,3723,2569,2206,1238,1082}
    };
    public double[] leadDias = {30,21,21,21,45,21};
    public double[] cobertura = {5.5,4.5,4,4,7.5,4};
    public double[] rate = {667,405,237,176,104,64};
    public double mermaLav = 0.03;
    public double mermaLiq = 0.05;
    public double tiemposFactor = 1.0;
    public double capacidadFactor = 1.0;
    public double factLatigo = 1.5;
    public double horas = 40.0;
    public double calentamiento = 15.0;
    public int reactores = 4;
    public int cola = 20;
    public int tanque = 3;

    public static int indice(String productname) {
        if (productname == null) throw new IllegalArgumentException("producto null");
        String nombre = productname.trim().toUpperCase(Locale.ROOT)
                .replace(' ', '_').replace('-', '_');
        for (int i = 0; i < PRODUCTOS.length; i++) if (PRODUCTOS[i].equals(nombre)) return i;
        throw new IllegalArgumentException("Producto desconocido: " + productname);
    }

    public ConfiguracionDomitec copiarDeep() {
        ConfiguracionDomitec c = new ConfiguracionDomitec();
        c.medias = copiar(medias);
        c.desvios = copiar(desvios);
        c.leadDias = copiar(leadDias);
        c.cobertura = copiar(cobertura);
        c.rate = copiar(rate);
        c.mermaLav = mermaLav; c.mermaLiq = mermaLiq;
        c.tiemposFactor = tiemposFactor; c.capacidadFactor = capacidadFactor;
        c.factLatigo = factLatigo; c.horas = horas; c.calentamiento = calentamiento;
        c.reactores = reactores; c.cola = cola; c.tanque = tanque;
        return c;
    }

    /** Devuelve this para permitir encadenar validacion antes de pasar la configuracion. */
    public ConfiguracionDomitec validar() {
        matriz("medias", medias, true);
        matriz("desvios", desvios, true);
        vector("leadDias", leadDias, true);
        vector("cobertura", cobertura, true);
        vector("rate", rate, true);
        for (int i = 0; i < rate.length; i++)
            if (rate[i] <= 0.0) throw new IllegalArgumentException("rate[" + i + "] debe ser > 0");
        finito("mermaLav", mermaLav); finito("mermaLiq", mermaLiq);
        if (mermaLav < 0.0 || mermaLav > 1.0 || mermaLiq < 0.0 || mermaLiq > 1.0)
            throw new IllegalArgumentException("mermas deben estar entre 0 y 1");
        positivo("tiemposFactor", tiemposFactor); positivo("capacidadFactor", capacidadFactor);
        positivo("factLatigo", factLatigo); positivo("horas", horas);
        if (horas > 168.0) throw new IllegalArgumentException("horas no puede superar 168 por semana");
        noNegativo("calentamiento", calentamiento);
        if (calentamiento >= 100.0) throw new IllegalArgumentException("calentamiento debe ser < 100 semanas");
        if (reactores < 1 || cola < 1 || tanque < 1)
            throw new IllegalArgumentException("reactores, cola y tanque deben ser >= 1");
        return this;
    }

    /** Variante de capacidad/turno utilizada por cada escenario. */
    public ConfiguracionDomitec escenario(int escenario) {
        if (escenario < 0 || escenario > 2)
            throw new IllegalArgumentException("escenario debe ser 0, 1 o 2");
        ConfiguracionDomitec c = copiarDeep();
        if (escenario == 0) { c.factLatigo = 1.5; c.horas = 40.0; }
        else if (escenario == 1) { c.factLatigo = 1.0; c.horas = 40.0; }
        else { c.factLatigo = 1.0; c.horas = 51.0; }
        return c;
    }

    /** Factor que convierte una jornada semanal a capacidad de 168 horas. */
    public double escalaTurno() { return 168.0 / horas; }

    private static double[][] copiar(double[][] x) {
        if (x == null) return null;
        double[][] r = new double[x.length][];
        for (int i=0; i<x.length; i++) r[i] = copiar(x[i]);
        return r;
    }
    private static double[] copiar(double[] x) {
        if (x == null) return null;
        double[] r = new double[x.length]; System.arraycopy(x,0,r,0,x.length); return r;
    }
    private static void matriz(String nombre, double[][] m, boolean noNeg) {
        if (m == null || m.length != 3) throw new IllegalArgumentException(nombre + " debe tener 3 filas");
        for (int i=0;i<m.length;i++) vector(nombre + "["+i+"]",m[i],noNeg);
    }
    private static void vector(String nombre, double[] v, boolean noNeg) {
        if (v == null || v.length != 6) throw new IllegalArgumentException(nombre + " debe tener 6 valores");
        for (int i=0;i<v.length;i++) {
            finito(nombre+"["+i+"]",v[i]);
            if (noNeg && v[i] < 0) throw new IllegalArgumentException(nombre+" no admite negativos");
        }
    }
    private static void finito(String n,double v) {
        if (Double.isNaN(v)||Double.isInfinite(v)) throw new IllegalArgumentException(n+" debe ser finito");
    }
    private static void positivo(String n,double v) {
        finito(n,v); if (v <= 0) throw new IllegalArgumentException(n+" debe ser > 0");
    }
    private static void noNegativo(String n,double v) {
        finito(n,v); if (v < 0) throw new IllegalArgumentException(n+" debe ser >= 0");
    }
}
]]></Text></JavaClass><JavaClass><Id>3699000001148</Id><Name>RegistroCorrida</Name><Text><![CDATA[import java.io.Serializable;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.Deque;
import java.util.List;
import java.util.Map;
import java.util.TreeMap;

/** Estadisticas por corrida sin dependencias del motor de simulacion. */
public final class RegistroCorrida implements Serializable {
    private static final long serialVersionUID = 1L;

    private static final class Cohorte implements Serializable {
        private static final long serialVersionUID = 1L;
        final int producto; final double tiempo, demanda;
        double cumplido, inmediato;
        Cohorte(int producto,double tiempo,double demanda) {
            this.producto=producto; this.tiempo=tiempo; this.demanda=demanda;
        }
        double pendiente() { return Math.max(0.0, demanda-cumplido); }
    }
    private static final class Semana implements Serializable {
        private static final long serialVersionUID = 1L;
        final double tiempo,demanda,ordenes,produccion,stock,backlog,wip;
        Semana(double t,double d,double o,double p,double s,double b,double w) {
            tiempo=t;demanda=d;ordenes=o;produccion=p;stock=s;backlog=b;wip=w;
        }
    }
    private static final class DemandaKey implements Comparable<DemandaKey>, Serializable {
        private static final long serialVersionUID = 1L;
        final String canal; final int producto; final long semana;
        DemandaKey(String c,int p,long s) { canal=c;producto=p;semana=s; }
        public int compareTo(DemandaKey x) {
            int c=canal.compareTo(x.canal); if(c!=0)return c;
            c=Integer.compare(producto,x.producto); return c!=0?c:Long.compare(semana,x.semana);
        }
    }

    private final List<Cohorte> cohortes = new ArrayList<Cohorte>();
    private final List<Semana> semanas = new ArrayList<Semana>();
    private final Map<Integer, Deque<Cohorte>> pendientes = new TreeMap<Integer, Deque<Cohorte>>();
    private final Map<DemandaKey, Double> entradas = new TreeMap<DemandaKey, Double>();

    /** Registra demanda. Si inmediato=true la cohorte se considera atendida al instante. */
    public void pedido(int producto, double tiempo, double cantidad, boolean inmediato) {
        validarProducto(producto); noNegativo("tiempo",tiempo); positivo("cantidad",cantidad);
        Cohorte c = new Cohorte(producto,tiempo,cantidad);
        cohortes.add(c);
        if (inmediato) { c.cumplido=cantidad; c.inmediato=cantidad; }
        else {
            Deque<Cohorte> q=pendientes.get(producto);
            if(q==null){q=new ArrayDeque<Cohorte>();pendientes.put(producto,q);}
            q.addLast(c);
        }
    }

    /** Satisface pedidos pendientes en orden FIFO por producto. El excedente se descarta. */
    public void diferido(int producto, double tiempo, double cantidad) {
        validarProducto(producto); noNegativo("tiempo",tiempo); noNegativo("cantidad",cantidad);
        double restante=cantidad;
        Deque<Cohorte> q=pendientes.get(producto);
        while(restante>0.0 && q!=null && !q.isEmpty()) {
            Cohorte c=q.peekFirst();
            double asignado=Math.min(restante,c.pendiente());
            c.cumplido+=asignado; restante-=asignado;
            if(c.pendiente()<=1e-12) q.removeFirst();
        }
    }

    public void produccion(double tiempo,double cantidad) {
        noNegativo("tiempo",tiempo);noNegativo("produccion",cantidad);
        // Produccion tambien puede registrarse como agregado independiente de la serie semanal.
        produccionEventos.add(new double[]{tiempo,cantidad});
    }

    private final List<double[]> produccionEventos = new ArrayList<double[]>();

    public void semanal(double tiempo,double demanda,double ordenes,double produccion,
                        double stock,double backlog,double wip) {
        noNegativo("tiempo",tiempo);noNegativo("demanda",demanda);noNegativo("ordenes",ordenes);
        noNegativo("produccion",produccion);noNegativo("stock",stock);
        noNegativo("backlog",backlog);noNegativo("wip",wip);
        semanas.add(new Semana(tiempo,demanda,ordenes,produccion,stock,backlog,wip));
    }

    /** Cantidad de tuplas semanales registradas. */
    public int numeroSemanas() { return semanas.size(); }

    /** Cantidad de claves canal/producto/semana unicas en la firma de demanda. */
    public int numeroEntradas() { return entradas.size(); }

    /** Fraccion de demanda posterior al warmup que fue finalmente satisfecha. */
    public double fillRate(double warmup) {
        noNegativo("warmup",warmup); double d=0,f=0;
        for(Cohorte c:cohortes) if(c.tiempo>=warmup){d+=c.demanda;f+=c.cumplido;}
        return d==0.0?0.0:f/d;
    }

    /** Fraccion de demanda posterior al warmup que se atendio al llegar. */
    public double fillInmediato(double warmup) {
        noNegativo("warmup",warmup); double d=0,f=0;
        for(Cohorte c:cohortes) if(c.tiempo>=warmup){d+=c.demanda;f+=c.inmediato;}
        return d==0.0?0.0:f/d;
    }

    public double demandaTotal(double warmup) {
        noNegativo("warmup",warmup);double total=0;
        for(Cohorte c:cohortes)if(c.tiempo>=warmup)total+=c.demanda;
        return total;
    }

    public double produccionTotal(double warmup) {
        noNegativo("warmup",warmup);double total=0;
        if(!produccionEventos.isEmpty()) {
            for(double[] e:produccionEventos)if(e[0]>=warmup)total+=e[1];
        } else {
            for(Semana s:semanas)if(s.tiempo>=warmup)total+=s.produccion;
        }
        return total;
    }

    /** Bullwhip = varianza muestral semanal de ordenes / varianza de demanda. */
    public double bw(double warmup) {
        noNegativo("warmup",warmup);List<Semana> xs=semanasTras(warmup);
        if(xs.size()<2)return 0.0;
        double vo=varianza(xs,true),vd=varianza(xs,false);
        return vd==0.0?0.0:vo/vd;
    }

    /** Registra la demanda base keyed; entradas repetidas de la misma clave se acumulan. */
    public void entrada(int canal,int producto,long semana,double cantidad) {
        entrada(Integer.toString(canal),producto,semana,cantidad);
    }
    public void entrada(String canal,int producto,long semana,double cantidad) {
        if(canal==null)throw new IllegalArgumentException("canal null");
        validarProducto(producto);noNegativo("semana",semana);noNegativo("cantidad",cantidad);
        DemandaKey key=new DemandaKey(canal,producto,semana);
        Double anterior=entradas.get(key);entradas.put(key,(anterior==null?0.0:anterior)+cantidad);
    }

    /** SHA-256 del CSV canonico, ordenado por canal, producto y semana. */
    public String firmaDemanda() {
        StringBuilder canon=new StringBuilder("canal,producto,semana,cantidad\n");
        for(Map.Entry<DemandaKey,Double> e:entradas.entrySet()) {
            DemandaKey k=e.getKey();
            canon.append(k.canal).append(',').append(k.producto).append(',').append(k.semana).append(',')
                    .append(Double.toString(e.getValue())).append('\n');
        }
        try {
            byte[] hash=MessageDigest.getInstance("SHA-256").digest(canon.toString().getBytes(StandardCharsets.UTF_8));
            StringBuilder hex=new StringBuilder(hash.length*2);
            for(byte b:hash)hex.append(String.format("%02x",b&0xff));
            return hex.toString();
        } catch(NoSuchAlgorithmException impossible) { throw new IllegalStateException("JRE sin SHA-256",impossible); }
    }

    public String seriesCsv(int seed,int escenario) {
        StringBuilder b=new StringBuilder("seed,escenario,semana,demanda,ordenes,produccion,stock,backlog,wip\n");
        List<Semana> xs=new ArrayList<Semana>(semanas);
        Collections.sort(xs,new Comparator<Semana>() { public int compare(Semana a,Semana z){return Double.compare(a.tiempo,z.tiempo);} });
        for(Semana s:xs)b.append(seed).append(',').append(escenario).append(',').append(s.tiempo).append(',')
                .append(s.demanda).append(',').append(s.ordenes).append(',').append(s.produccion).append(',')
                .append(s.stock).append(',').append(s.backlog).append(',').append(s.wip).append('\n');
        return b.toString();
    }

    public String resumen() {
        StringBuilder b=new StringBuilder("Cohortes: ").append(cohortes.size()).append("; semanas: ")
                .append(semanas.size()).append("; firmaDemanda: ").append(firmaDemanda()).append('\n');
        b.append("fillRate=").append(fillRate(0)).append("; fillInmediato=").append(fillInmediato(0))
                .append("; demanda=").append(demandaTotal(0)).append("; produccion=").append(produccionTotal(0))
                .append("; bw=").append(bw(0));
        return b.toString();
    }

    private List<Semana> semanasTras(double warmup){
        List<Semana> xs=new ArrayList<Semana>();for(Semana s:semanas)if(s.tiempo>=warmup)xs.add(s);return xs;
    }
    private static double varianza(List<Semana> xs,boolean ordenes){
        double media=0;for(Semana s:xs)media+=(ordenes?s.ordenes:s.demanda);media/=xs.size();
        double suma=0;for(Semana s:xs){double v=ordenes?s.ordenes:s.demanda;suma+=(v-media)*(v-media);}
        return suma/(xs.size()-1);
    }
    private static void validarProducto(int p){if(p<0||p>=6)throw new IllegalArgumentException("producto debe ser indice 0..5");}
    private static void noNegativo(String n,double x){if(Double.isNaN(x)||Double.isInfinite(x)||x<0)throw new IllegalArgumentException(n+" debe ser finito y >= 0");}
    private static void positivo(String n,double x){noNegativo(n,x);if(x==0)throw new IllegalArgumentException(n+" debe ser > 0");}
}
]]></Text></JavaClass><JavaClass><Id>3699000001149</Id><Name>SesionEstudio</Name><Text><![CDATA[/** Estado compartido, de solo lectura para la interfaz, del estudio 100 x 3. */
public final class SesionEstudio {
    private SesionEstudio() { }

    /** Texto breve del estado actual; las vistas solo deben leerlo. */
    public static volatile String estado = "Inactivo";
    /** Corridas terminadas, de 0 a 300. */
    public static volatile int progreso = 0;
    public static volatile boolean ejecutando = false;
    /** Solicitud cooperativa; el runner solo debe comprobarla entre ternas. */
    public static volatile boolean cancelar = false;
    /** Último resumen completo de una terna seed x tres escenarios. */
    public static volatile String ultimoResumen = "";
    /** Último comparador completo; solo se reemplaza al publicar un lote exitoso. */
    public static volatile ComparacionEscenarios ultimoResultado = null;
    /** Copia inmutable por convenio de la configuración que lanzó el lote. */
    public static volatile ConfiguracionDomitec configuracionEnCurso = null;
    /** Destino base de los cuatro CSV publicados al terminar 300 corridas. */
    public static volatile String carpetaEnCurso = java.nio.file.Paths.get(
            System.getProperty("user.dir"), "resultados_domitec").toString();

    /** Reserva la sesión de forma atómica. Devuelve false si ya hay una activa. */
    public static synchronized boolean iniciar() {
        if (ejecutando) return false;
        ejecutando = true;
        cancelar = false;
        progreso = 0;
        estado = "Preparando comparación (0/300)";
        ultimoResumen = "";
        return true;
    }

    /** Cierra la sesión; error null/blank indica finalización normal. */
    public static synchronized void finalizar(String error) {
        ejecutando = false;
        if (error == null || error.trim().isEmpty()) {
            estado = "Completado (" + progreso + "/300)";
        } else if (error.toLowerCase(java.util.Locale.ROOT).contains("cancel")) {
            estado = error;
        } else {
            estado = "Error: " + error;
        }
    }

    /** Finaliza y publica el comparador completo en la misma sección sincronizada. */
    public static synchronized void finalizar(String error, ComparacionEscenarios resultado) {
        if (error == null || error.trim().isEmpty()) {
            if (resultado != null) ultimoResultado = resultado;
            ejecutando = false;
            estado = "Completado (" + progreso + "/300)";
        } else {
            finalizar(error);
        }
    }
}
]]></Text></JavaClass><JavaClass><Id>3699000001150</Id><Name>EstudioPareado</Name><Text><![CDATA[import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.AtomicMoveNotSupportedException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.time.Instant;
import java.time.ZoneOffset;
import java.time.format.DateTimeFormatter;
import java.util.UUID;

/** Acumula 100 ternas por semilla y publica el paquete estadístico sin depender de AnyLogic. */
public final class EstudioPareado {
    private static final int N = 100;
    private static final int ESCENARIOS = 3;
    private static final String VERSION_MODELO = "Domitec_Main_3D; AnyLogic 8.9.10";
    private static final DateTimeFormatter FORMATO_UTC =
            DateTimeFormatter.ofPattern("yyyyMMdd_HHmmss_SSS").withZone(ZoneOffset.UTC);

    private final ComparacionEscenarios comparacion = new ComparacionEscenarios();
    private final StringBuilder resultadosCsv = new StringBuilder(
            "seed,escenario,firma_demanda,warmup_semanas,fillRate,backlog,stock,bw,produccion\n");
    private final StringBuilder seriesCsv = new StringBuilder(
            "seed,escenario,semana,demanda,ordenes,produccion,stock,backlog,wip\n");
    private final ComparacionEscenarios.Resultado[] terna = new ComparacionEscenarios.Resultado[ESCENARIOS];
    private final String[] firmas = new String[ESCENARIOS];
    private final String[] series = new String[ESCENARIOS];
    private int registros = 0;
    private boolean terminado = false;
    private String salida = "";
    private Double warmupEstudio = null;

    /**
     * Agrega una corrida ya finalizada por el experimento de variación de parámetros.
     * El principal debe validar antes número de semanas y número de entradas de demanda.
     */
    public synchronized void agregar(ComparacionEscenarios.Resultado resultado,
                                     String firmaDemanda,
                                     String serieCsv,
                                     double warmupSemanas,
                                     ConfiguracionDomitec configuracion,
                                     String destino) {
        try {
            validarSiguiente(resultado, firmaDemanda, serieCsv, warmupSemanas, configuracion);
            iniciarSesionSiHaceFalta(configuracion, destino);

            final int seed = resultado.seed;
            final int escenario = resultado.escenario;
            final int seedEsperada = registros / ESCENARIOS + 1;
            final int escenarioEsperado = registros % ESCENARIOS;
            terna[escenario] = resultado;
            firmas[escenario] = firmaDemanda;
            series[escenario] = soloFilas(serieCsv);
            registros++;
            SesionEstudio.progreso = registros;
            SesionEstudio.estado = "Corrida " + registros + "/300 (semilla " + seed + ", escenario " + escenario + ")";

            if (escenario == ESCENARIOS - 1) {
                verificarFirmas(seed);
                for (int s = 0; s < ESCENARIOS; s++) {
                    comparacion.agregar(terna[s]);
                    ComparacionEscenarios.Resultado r = terna[s];
                    resultadosCsv.append(seed).append(',').append(s).append(',').append(firmas[s]).append(',')
                            .append(warmupSemanas).append(',').append(r.fillRate).append(',').append(r.backlog).append(',')
                            .append(r.stock).append(',').append(r.bw).append(',').append(r.produccion).append('\n');
                    seriesCsv.append(series[s]);
                }
                SesionEstudio.ultimoResumen = "Semilla " + seed + ": 3 escenarios, demanda base verificada; "
                        + "fillRate=" + terna[0].fillRate + "," + terna[1].fillRate + "," + terna[2].fillRate;
                limpiarTerna();
            }

            if (registros == N * ESCENARIOS) finalizarExitoso(configuracion, destino);
        } catch (Throwable error) {
            if (SesionEstudio.ejecutando) SesionEstudio.finalizar(mensajeError(error));
            if (error instanceof Error) throw (Error) error;
            if (error instanceof RuntimeException) throw (RuntimeException) error;
            throw new RuntimeException(error);
        }
    }

    public synchronized int getCount() { return comparacion.getCount(); }
    public synchronized boolean isTerminado() { return terminado; }
    public synchronized String getSalida() { return salida; }

    private void validarSiguiente(ComparacionEscenarios.Resultado r, String firma, String seriesCsv,
                                  double warmup, ConfiguracionDomitec cfg) {
        if (terminado || registros >= N * ESCENARIOS) throw new IllegalStateException("El estudio ya terminó");
        if (r == null || cfg == null) throw new IllegalArgumentException("resultado/configuración no pueden ser null");
        if (r.seed != registros / ESCENARIOS + 1)
            throw new IllegalArgumentException("Semilla fuera de orden: se esperaba " + (registros / ESCENARIOS + 1));
        if (r.escenario != registros % ESCENARIOS)
            throw new IllegalArgumentException("Escenario fuera de orden: se esperaba " + (registros % ESCENARIOS));
        if (firma == null || !firma.matches("[0-9a-fA-F]{64}"))
            throw new IllegalArgumentException("firmaDemanda debe ser SHA-256 hexadecimal");
        if (seriesCsv == null || !seriesCsv.startsWith("seed,escenario,semana,"))
            throw new IllegalArgumentException("serieCsv debe proceder de RegistroCorrida.seriesCsv");
        if (!finito(warmup) || warmup < 0.0 || warmup >= 100.0)
            throw new IllegalArgumentException("warmupSemanas debe ser finito y estar en [0,100)");
        if (Math.abs(warmup - cfg.calentamiento) > 1e-9)
            throw new IllegalArgumentException("warmupSemanas debe coincidir con configuracion.calentamiento");
        if (warmupEstudio != null && Math.abs(warmupEstudio.doubleValue() - warmup) > 1e-9)
            throw new IllegalArgumentException("warmupSemanas cambió durante el lote");
        if (warmupEstudio == null) warmupEstudio = warmup;
        if (SesionEstudio.cancelar && registros % ESCENARIOS == 0)
            throw new java.util.concurrent.CancellationException("Cancelado antes de comenzar una nueva terna");
    }

    private void iniciarSesionSiHaceFalta(ConfiguracionDomitec cfg, String destino) {
        if (!SesionEstudio.ejecutando) {
            if (registros != 0 || !SesionEstudio.iniciar())
                throw new IllegalStateException("No se pudo iniciar la sesión de estudio");
            SesionEstudio.configuracionEnCurso = cfg.copiarDeep();
            SesionEstudio.carpetaEnCurso = Paths.get(System.getProperty("user.dir"), "resultados_domitec").toString();
        }
        if (SesionEstudio.configuracionEnCurso == null)
            SesionEstudio.configuracionEnCurso = cfg.copiarDeep();
        if (destino != null && !destino.trim().isEmpty()) SesionEstudio.carpetaEnCurso = destino;
    }

    private void verificarFirmas(int seed) {
        if (firmas[0] == null || !firmas[0].equals(firmas[1]) || !firmas[0].equals(firmas[2]))
            throw new IllegalStateException("Firma de demanda distinta entre escenarios en seed " + seed
                    + ": " + firmas[0] + " / " + firmas[1] + " / " + firmas[2]);
    }

    private String soloFilas(String csv) {
        int nl = csv.indexOf('\n');
        if (nl < 0 || nl == csv.length() - 1) throw new IllegalArgumentException("serieCsv no contiene datos semanales");
        return csv.substring(nl + 1);
    }

    private void limpiarTerna() {
        for (int i = 0; i < ESCENARIOS; i++) { terna[i] = null; firmas[i] = null; series[i] = null; }
    }

    private void finalizarExitoso(ConfiguracionDomitec cfg, String destino) throws IOException {
        if (comparacion.getCount() != 300 || comparacion.getTernasOrdenadas().size() != 100)
            throw new IllegalStateException("Resultados incompletos: " + comparacion.getCount());
        String stamp = FORMATO_UTC.format(Instant.now());
        ConfiguracionDomitec configMetadata = SesionEstudio.configuracionEnCurso == null
                ? cfg : SesionEstudio.configuracionEnCurso;
        String metadata = metadata(stamp, configMetadata);
        String csvIC = construirIC();
        Path carpeta = publicarAtomico(destino, stamp, resultadosCsv.toString(), seriesCsv.toString(), csvIC, metadata);
        salida = carpeta.toString();
        terminado = true;
        SesionEstudio.progreso = 300;
        SesionEstudio.ultimoResumen = "Estudio terminado: 300 corridas, 100 ternas. Salida: " + salida;
        // Se publica una sola vez al cerrar la sesión; después no habrá más mutaciones.
        SesionEstudio.finalizar(null, comparacion);
    }

    private String construirIC() {
        StringBuilder b = new StringBuilder("escenario_a,escenario_b,metrica,n,df,media,desviacion,sem,t_critico,ic95_inferior,ic95_superior\n");
        int[][] pares = {{0,1},{0,2},{1,2}};
        String[] metricas = {"fillRate", "backlog", "stock", "bw", "produccion"};
        for (int[] p : pares) for (String metrica : metricas) {
            ComparacionEscenarios.PairCI95 ci = comparacion.pairCI95(p[0], p[1], metrica);
            if (!ci.disponible || ci.n != 100 || ci.df != 99)
                throw new IllegalStateException("IC pareado incompleto para " + metrica);
            b.append(ci.escenarioA).append(',').append(ci.escenarioB).append(',').append(metrica).append(',')
                    .append(ci.n).append(',').append(ci.df).append(',').append(ci.media).append(',')
                    .append(ci.desviacion).append(',').append(ci.sem).append(',').append(ci.tCritico).append(',')
                    .append(ci.inferior).append(',').append(ci.superior).append('\n');
        }
        return b.toString();
    }

    private String metadata(String stamp, ConfiguracionDomitec cfg) {
        StringBuilder b = new StringBuilder();
        b.append("created_utc=").append(Instant.now().toString()).append('\n')
                .append("run_id=").append(stamp).append('\n')
                .append("model_version=").append(VERSION_MODELO).append('\n')
                .append("seeds=1..100\nscenarios=0,1,2\nreplicas=100\nrun_count=300\nweeks=100\n")
                .append("warmup_weeks=").append(cfg.calentamiento).append('\n')
                .append("warmup_policy=Main.resultadoFinal excludes weeks before configured warmup; finite horizon\n")
                .append("common_demand=equal firmaDemanda SHA-256 within each seed\n")
                .append("paired_ci=two-sided Student t 95%, matched by seed, scenario_a minus scenario_b\n")
                .append("\n[configuracion_domitec]\n");
        b.append("mermaLav=").append(cfg.mermaLav).append('\n').append("mermaLiq=").append(cfg.mermaLiq).append('\n')
                .append("tiemposFactor=").append(cfg.tiemposFactor).append('\n').append("capacidadFactor=").append(cfg.capacidadFactor).append('\n')
                .append("factLatigo=").append(cfg.factLatigo).append('\n').append("horas=").append(cfg.horas).append('\n')
                .append("calentamiento=").append(cfg.calentamiento).append('\n').append("reactores=").append(cfg.reactores).append('\n')
                .append("cola=").append(cfg.cola).append('\n').append("tanque=").append(cfg.tanque).append('\n');
        vector(b, "leadDias", cfg.leadDias); vector(b, "cobertura", cfg.cobertura); vector(b, "rate", cfg.rate);
        for (int i = 0; i < cfg.medias.length; i++) vector(b, "medias[" + i + "]", cfg.medias[i]);
        for (int i = 0; i < cfg.desvios.length; i++) vector(b, "desvios[" + i + "]", cfg.desvios[i]);
        return b.toString();
    }

    private void vector(StringBuilder b, String nombre, double[] valores) {
        b.append(nombre).append('=');
        for (int i = 0; i < valores.length; i++) { if (i > 0) b.append(','); b.append(valores[i]); }
        b.append('\n');
    }

    private Path publicarAtomico(String destino, String stamp, String datos, String series,
                                 String ic, String metadata) throws IOException {
        String baseText = destino == null || destino.trim().isEmpty()
                ? SesionEstudio.carpetaEnCurso : destino;
        Path base = Paths.get(baseText).toAbsolutePath().normalize();
        Files.createDirectories(base);
        Path staging = Files.createTempDirectory(base, ".estudio-" + stamp + "-");
        boolean publicado = false;
        try {
            escribir(staging.resolve("resultados.csv"), datos);
            escribir(staging.resolve("series_semanales.csv"), series);
            escribir(staging.resolve("ic_pareados.csv"), ic);
            escribir(staging.resolve("metadata.txt"), metadata);
            Path finalDir = base.resolve("comparacion_" + stamp);
            if (Files.exists(finalDir)) finalDir = base.resolve("comparacion_" + stamp + "_" + UUID.randomUUID());
            try { Files.move(staging, finalDir, StandardCopyOption.ATOMIC_MOVE); }
            catch (AtomicMoveNotSupportedException e) { Files.move(staging, finalDir); }
            publicado = true;
            return finalDir;
        } finally {
            if (!publicado && Files.exists(staging)) borrarTemporal(staging);
        }
    }

    private void escribir(Path p, String s) throws IOException {
        Files.write(p, s.getBytes(StandardCharsets.UTF_8));
    }

    private void borrarTemporal(Path dir) throws IOException {
        java.util.stream.Stream<Path> paths = Files.walk(dir);
        try { paths.sorted(java.util.Comparator.reverseOrder()).forEach(p -> {
            try { Files.deleteIfExists(p); } catch (IOException e) { throw new RuntimeException(e); }
        }); } finally { paths.close(); }
    }

    private String mensajeError(Throwable e) {
        String m = e.getMessage();
        return e.getClass().getSimpleName() + (m == null || m.trim().isEmpty() ? "" : ": " + m);
    }

    private static boolean finito(double d) { return !Double.isNaN(d) && !Double.isInfinite(d); }
}
]]></Text></JavaClass></JavaClasses>
	<ModelResources>
		<Resource>
			<Id>3699000001151</Id>
			<Path><![CDATA[3d/barrel.dae]]></Path>
