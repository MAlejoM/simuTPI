		<Name><![CDATA[ParametersVariation]]></Name>
		<CommandLineArguments/>
		<MaximumMemory>512</MaximumMemory>
		<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
		<CustomGeneratorCode>new Random()</CustomGeneratorCode>
		<AfterSimulationRunCode>double fr = (root.domitecPlant.demandaTotalAcumulada &gt; 0) ? 
    (root.domitecPlant.despachoTotalAcumulado / root.domitecPlant.demandaTotalAcumulada) * 100.0 : 0.0;

double totBacklog = 0;
for (ProductState ps : root.domitecPlant.inventorySystem) {
    totBacklog += ps.backlog;
}

traceln("&gt;&gt;&gt; [RÉPLICA #" + getCurrentIteration() + "] Fill Rate: " + String.format("%.2f%%", fr) + " | Backlog: " + Math.round(totBacklog) + " cajas");</AfterSimulationRunCode>
